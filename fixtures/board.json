    "deps": [["a", "c"], ["b", "c"], ["d", "e"], ["a", "e"]],
    "expect": {
      "status": { "a": "ready", "b": "ready", "c": "waiting 2", "d": "done", "e": "waiting 1" },
      "unlocks": { "a": ["e"], "b": [] },
      "order": { "/": ["a", "b", "c", "e", "d"] },
      "next": ["a", "b"]
    }
  },
