[
  {
    "name": "依赖决定状态和顺序",
    "folders": [],
    "tasks": [
      { "id": "a", "key": "a0" },
      { "id": "b", "key": "a1" },
      { "id": "c", "key": "a2" },
      { "id": "d", "key": "a3" }
    ],
    "deps": [["a", "b"], ["b", "c"]],
    "expect": {
      "status": { "a": "ready", "b": "waiting 1", "c": "waiting 1", "d": "ready" },
      "unlocks": { "a": ["b"], "b": ["c"], "c": [], "d": [] },
      "order": { "/": ["a", "b", "c", "d"] },
      "next": ["a", "d"]
    }
  },
  {
    "name": "依赖优先于手动顺序，没有先后约束的按手动顺序",
    "folders": [],
    "tasks": [
      { "id": "late", "key": "a0" },
      { "id": "early", "key": "a5" },
      { "id": "free", "key": "a2" }
    ],
    "deps": [["early", "late"]],
    "expect": {
      "status": { "late": "waiting 1", "early": "ready", "free": "ready" },
      "unlocks": { "early": ["late"] },
      "order": { "/": ["free", "early", "late"] },
      "next": ["free", "early"]
    }
  },
  {
    "name": "经过文件夹外事项的间接依赖也算先后约束",
    "folders": [
      { "id": "f", "name": "前端", "key": "a0" },
      { "id": "g", "name": "后端", "key": "a1" }
    ],
    "tasks": [
      { "id": "x", "folder": "g", "key": "a0" },
      { "id": "b", "folder": "f", "key": "a0" },
      { "id": "a", "folder": "f", "key": "a1" },
      { "id": "p", "folder": "f", "key": "a2" },
      { "id": "y", "folder": "g", "key": "a1" },
      { "id": "q", "folder": "f", "key": "a3" }
    ],
    "deps": [["a", "x"], ["x", "b"], ["y", "p"]],
    "expect": {
      "status": { "a": "ready", "x": "waiting 1", "b": "waiting 1", "p": "waiting 1", "y": "ready", "q": "ready" },
      "order": { "f": ["a", "b", "p", "q"], "g": ["x", "y"] },
      "next": ["a", "q", "y"]
    }
  },
  {
    "name": "经过多个文件夹外事项的间接依赖也算；外面事项的其它前置不影响文件夹里的顺序",
    "folders": [
      { "id": "f", "name": "前端", "key": "a0" },
      { "id": "g", "name": "后端", "key": "a1" }
    ],
    "tasks": [
      { "id": "c", "folder": "f", "key": "a0" },
      { "id": "b", "folder": "f", "key": "a1" },
      { "id": "a", "folder": "f", "key": "a2" },
      { "id": "x1", "folder": "g", "key": "a0" },
      { "id": "x2", "folder": "g", "key": "a1" },
      { "id": "z", "folder": "g", "key": "a2" }
    ],
    "deps": [["a", "x1"], ["x1", "x2"], ["x2", "c"], ["z", "x2"]],
    "expect": {
      "status": { "a": "ready", "b": "ready", "c": "waiting 1", "x1": "waiting 1", "x2": "waiting 2", "z": "ready" },
      "order": { "f": ["b", "a", "c"], "g": ["x1", "z", "x2"] },
      "next": ["b", "a", "z"]
    }
  },
  {
    "name": "已完成的排在最后，最近完成的在前；经过已完成事项的路径不算约束",
    "folders": [],
    "tasks": [
      { "id": "b", "key": "a0" },
      { "id": "x", "key": "a1", "done_at": 100 },
      { "id": "a", "key": "a2" },
      { "id": "y", "key": "a3", "done_at": 200 }
    ],
    "deps": [["a", "x"], ["x", "b"]],
    "expect": {
      "status": { "b": "ready", "x": "done", "a": "ready", "y": "done" },
      "unlocks": { "x": [], "a": [] },
      "order": { "/": ["b", "a", "y", "x"] },
      "next": ["b", "a"]
    }
  },
  {
    "name": "一个后续有多个前置时，做完其中一个不算解锁",
    "folders": [],
    "tasks": [
      { "id": "a", "key": "a0" },
      { "id": "b", "key": "a1" },
      { "id": "c", "key": "a2" },
      { "id": "d", "key": "a3", "done_at": 1 },
      { "id": "e", "key": "a4" }
