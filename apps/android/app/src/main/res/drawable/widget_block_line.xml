<?xml version="1.0" encoding="utf-8"?>
<!-- A block of the “时间轴” widget for a later time of a repeating task: a line around it, as in the app. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="1dp">
    <shape android:shape="rectangle">
        <corners android:radius="6dp" />
        <stroke android:width="1dp" android:color="#FFFFFF" />
        <!-- Without a fill of its own, the tint fills it. -->
        <solid android:color="#00000000" />
    </shape>
</inset>
