{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NextTodo",
  "version": "../../web/package.json",
  "identifier": "cn.juniexd.nexttodo",
  "build": {
    "frontendDist": "../../web/dist",
    "beforeBuildCommand": "cd ../web && pnpm exec tsc && pnpm exec vite build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "NextTodo",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 560,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 22 },
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDNjdBQTQxNDMxRDA3NkEKUldScUJ4MURRYXBuVEwvMUg2bHpTUlRrNDJTTFhUVE95Z3pIUG0yb0lhbERmMjhMMDJwd2Q1Q2MK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "14.0"
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
